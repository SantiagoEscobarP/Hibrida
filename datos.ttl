  # =====================================================================
  # GRAFO 2: NOTICIAS Y EVENTOS (Flujo OK y Flujo PEND)
  # =====================================================================
  GRAPH <http://proyecto-noticias.org/graph/news> {

    # -------------------------------------------------------------------
    # CASO 1 (ESTADO "OK"): Noticia de Homicidio YA indexada con su Evento
    # -------------------------------------------------------------------
    <http://proyecto-noticias.org/news/not_yopal_001> a schema:NewsArticle ;
        schema:headline """Enviaron a la cárcel a alias Eduard, el segundo capturado por el asesinato de John 'Calzones', exalcalde de Yopal""" ;
        schema:articleBody """Un juez de control de garantías envió a la cárcel a Eduard Daniel Martínez, alias Eduard, por su presunta participación en el asesinato de John Jairo Torres, exalcalde de Yopal. Según la Fiscalía Seccional Casanare, habría conducido la motocicleta empleada en el ataque sicarial en la finca La Selvita.""" ;
        schema:publisher """El Tiempo - Justicia""" ;
        schema:datePublished "2026-10-12T14:30:00"^^xsd:dateTime ;
        core:tieneMateria <http://proyecto-noticias.org/authorities/mat_homicidio> ;
        core:relataEvento <http://proyecto-noticias.org/events/ev_yopal_001> .

    <http://proyecto-noticias.org/events/ev_yopal_001> a core:Evento ;
        core:tituloEvento """Judicialización de alias Eduard por homicidio de exalcalde de Yopal""" ;
        schema:abstract """Agentes del CTI de la Fiscalía y la Policía Nacional capturaron e imputaron por homicidio agravado a Eduard Daniel Martínez tras el ataque armado en la finca La Selvita de Yopal.""" ;
        core:municipio <http://proyecto-noticias.org/authorities/mun_yopal> ;
        core:municipioTexto """Yopal""" ;
        core:subdivisionTexto """Zona Rural""" ;
        core:complemento """Vereda / Finca La Selvita""" ;
        core:tieneMateria <http://proyecto-noticias.org/authorities/mat_homicidio> ;
        core:categoriaTexto """Homicidio""" ;
        schema:dateCreated "2026-10-13T10:15:00"^^xsd:dateTime ;
        core:agenteMencionado """John Jairo Torres""" ;
        core:agenteMencionado """Eduard Daniel Martínez""" ;
        core:involucraAgente [
            a core:Involucramiento ;
            core:tieneAutoridad <http://proyecto-noticias.org/authorities/aut_john_torres> ;
            core:tipoParticipacion core:Victima ;
            core:rol """Exalcalde / Víctima fatal"""
        ] ;
        core:involucraAgente [
            a core:Involucramiento ;
            core:tieneAutoridad <http://proyecto-noticias.org/authorities/aut_eduard_martinez> ;
            core:tipoParticipacion core:Victimario ;
            core:rol """Conductor de motocicleta en ataque sicarial"""
        ] ;
        core:payloadJson """{"fechaCatalogacion":"13/10/2026","titulo":"Judicialización de alias Eduard por homicidio de exalcalde de Yopal","resumen":"Agentes del CTI de la Fiscalía y la Policía Nacional capturaron e imputaron por homicidio agravado a Eduard Daniel Martínez tras el ataque armado en la finca La Selvita de Yopal.","municipio":"Yopal","subdivision":"Zona Rural","complemento":"Vereda / Finca La Selvita","afectados":[{"nombre":"John Jairo Torres","tipoNombre":"Persona","afiliacion":"Exalcalde","rol":"Víctima fatal"}],"victimarios":[{"nombre":"Eduard Daniel Martínez","tipoNombre":"Persona","afiliacion":"Sicariato","rol":"Coautor","edad":"26"}],"materiasList":[{"materia":"Homicidio","subjectSource":"Other","subjectType":"Topical term"}],"notasList":[{"tipo":"Nota de agentes","nota":"Capturado en Tunja por orden judicial","soloStaff":false}]}""" .

    # -------------------------------------------------------------------
    # CASO 2 (ESTADO "OK"): Noticia de Explosivos en Cauca YA indexada
    # -------------------------------------------------------------------
    <http://proyecto-noticias.org/news/not_cauca_002> a schema:NewsArticle ;
        schema:headline """Destruyen más de 250 kilos de explosivos en Miranda (Cauca) tras ataques contra la población""" ;
        schema:articleBody """Tropas del Ejército Nacional y la Policía ubicaron y destruyeron de manera controlada un depósito ilegal con más de 250 kilogramos de explosivos y artefactos improvisados atribuidos a disidencias en zona rural de Miranda, Cauca.""" ;
        schema:publisher """El Espectador - Judicial""" ;
        schema:datePublished "2026-10-13T09:20:00"^^xsd:dateTime ;
        core:tieneMateria <http://proyecto-noticias.org/authorities/mat_atentado> ;
        core:relataEvento <http://proyecto-noticias.org/events/ev_cauca_002> .

    <http://proyecto-noticias.org/events/ev_cauca_002> a core:Evento ;
        core:tituloEvento """Incautación y destrucción de 250 kg de explosivos en Miranda, Cauca""" ;
        schema:abstract """Operativo conjunto permitió neutralizar artefactos explosivos listos para ser empleados en hostigamientos contra la fuerza pública y población civil en el norte del Cauca.""" ;
        core:municipio <http://proyecto-noticias.org/authorities/mun_miranda> ;
        core:municipioTexto """Miranda (Cauca)""" ;
        core:subdivisionTexto """Zona montañosa""" ;
        core:complemento """Corregimiento El Ortigal""" ;
        core:tieneMateria <http://proyecto-noticias.org/authorities/mat_atentado> ;
        core:categoriaTexto """Atentado con Explosivos""" ;
        core:organizacionPerpetradora """Estado Mayor Central (Disidencias)""" ;
        schema:dateCreated "2026-10-13T16:40:00"^^xsd:dateTime ;
        core:agenteMencionado """Estado Mayor Central (Disidencias)""" ;
        core:payloadJson """{"fechaCatalogacion":"13/10/2026","titulo":"Incautación y destrucción de 250 kg de explosivos en Miranda, Cauca","resumen":"Operativo conjunto permitió neutralizar artefactos explosivos listos para ser empleados en hostigamientos contra la fuerza pública y población civil en el norte del Cauca.","municipio":"Miranda (Cauca)","subdivision":"Zona montañosa","complemento":"Corregimiento El Ortigal","afectados":[{"nombre":"Población Civil de Miranda","tipoNombre":"Entidad","afiliacion":"Comunidad","rol":"Afectado"}],"victimarios":[{"nombre":"Estado Mayor Central (Disidencias)","tipoNombre":"Grupo Criminal","afiliacion":"Frente Dagoberto Ramos","rol":"Perpetrador","edad":""}],"organizacion":{"id":"aut_disidencias_mordisco","nombre":"Estado Mayor Central (Disidencias)","alias":"Frente Dagoberto Ramos"},"materiasList":[{"materia":"Atentado con Explosivos","subjectSource":"Other","subjectType":"Topical term"}],"notasList":[]}""" .

    # -------------------------------------------------------------------
    # CASO 3 (ESTADO "PEND"): Noticia pendiente de indexar (Para que hagas la prueba manual)
    # -------------------------------------------------------------------
    <http://proyecto-noticias.org/news/not_bogota_003> a schema:NewsArticle ;
        schema:headline """En operativos simultáneos en Bogotá cayeron integrantes del Tren de Aragua y Los Buitres""" ;
        schema:articleBody """La Policía Metropolitana de Bogotá y la Fiscalía General de la Nación adelantaron 14 diligencias de allanamiento en las localidades de Kennedy y Bosa, logrando la detención de ocho presuntos integrantes dedicados a la extorsión y el microtráfico.""" ;
        schema:publisher """Alerta Bogotá""" ;
        schema:datePublished "2026-10-14T07:45:00"^^xsd:dateTime ;
        core:tieneMateria <http://proyecto-noticias.org/authorities/mat_detencion> .

    # -------------------------------------------------------------------
    # CASO 4 (ESTADO "PEND"): Segunda noticia pendiente (Hurto en Bogotá)
    # -------------------------------------------------------------------
    <http://proyecto-noticias.org/news/not_bogota_004> a schema:NewsArticle ;
        schema:headline """Reacción policial evitó fleteo de $30 millones en el sector de El Salitre en Bogotá""" ;
        schema:articleBody """Uniformados interceptaron a dos sujetos que se movilizaban en motocicleta tras intimidar con arma de fuego a un ciudadano que acababa de retirar dinero de una entidad bancaria en la localidad de Fontibón.""" ;
        schema:publisher """Q'hubo Bogotá""" ;
        schema:datePublished "2026-10-14T11:10:00"^^xsd:dateTime ;
        core:tieneMateria <http://proyecto-noticias.org/authorities/mat_hurto> .
